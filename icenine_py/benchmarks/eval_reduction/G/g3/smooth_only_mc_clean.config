########################################################################
#  Phase D full-sample BFS reconstruction (mc, clean images), MaxQ=8.
#  Run with cwd = Examples/Example2.ManyGrains. Python-only (LocalOptimizer keys).
#  Task G3, the "SmoothCostRank only" arm (D-20261029-N3): Task G2's integrated configuration
#  (benchmarks/eval_reduction/G/integrated_mc_clean.config) without OutwardSearch, i.e. the stored
#  pilot's configuration (scripts/phase_d/configs/ReconstructPhaseD_mc_clean.config plus
#  BFSReseed 1) with only SmoothCostRank E3+E4,tau=0.25 added.
########################################################################

########################################################################
#     Input and Output
########################################################################
InfileBasename     	      ScatteringData_PhaseD/full/clean/500Grains.sim
InfileSerialLength        5
OutfileBasename		      None
OutfileSerialLength       5
OutStructureBasename 	  PhaseD_mc_clean
BCPeakDetectorOffset      0
InFileType		          ascii
OutfileExtension    	  d
InfileExtension           d

########################################################################
# Beam Information
########################################################################
BeamEnergyWidth            0.5
BeamDirection              1 0 0
BeamDeflectionChiLaue      0
BeamHeight                 0.0012
BeamEnergy                 64.351

########################################################################
# Detector Information
########################################################################
DetectorFilename  ConfigFiles/StandardGeometry.2Det
EtaLimit          86

########################################################################
# Data and initialization file
########################################################################
SampleFilename           SimInput/rand_500grains_1mm_neworient_s0_grid.mic
StructureFilename        DataFiles/copper.dat
RotationRangeFilename    DataFiles/omega_180_2L.dat
FundamentalZoneFilename  DataFiles/MyFZ.dat
SampleSymmetry           Cubic

########################################################################
# Simulation information — MaxQ reduced to 8 for benchmarking
########################################################################
MinAmplitudeFraction   0.25
MaxQ 		               8
MaxInitSideLength      0.009375
MinSideLength          0.009375

########################################################################
#   Search Parameters
########################################################################
LocalOrientationGridRadius    5
MinLocalResolution            0
MaxLocalResolution            3
MaxAcceptedCost               0.9000
MaxConvergenceCost            0.0001
MaxMCSteps                    200
MCRadiusScaleFactor           0.4
SuccessiveRestarts            2
SecondsBetweenSave            1800

########################################################################
# Parameter Optimization
########################################################################
NumParameterOptimizationSteps   200
NumElementToOptimizePerPE       20
OptimizationFilename            ConfigFiles/Optimization.2Det
DetectionLimitFilename          ConfigFiles/Sensitivity.2Det
ParameterMCInitTemperature      0.001
OrientationSearchMethod         ConstrainedEuler
CoolingFraction                 0.05
ThermalizeFraction              0.01
ParameterRefinements            2

NumDetectors                          2
DetectorSpacing                       0  2.0
DetectorSpacingDeviation              0.010
DetectorOrientationDeviationInEuler   0.5 0.5 .5
DetectorOrientationDeviationInSO3     1

####
# Advanced options
####
ParamMCMaxLocalRestarts               0
ParamMCMaxGlobalRestarts              0
ParamMCNumGlobalSearchElements        5
ConstrainedOptimization               1
SearchVolumeReductionFactor           4

########################################################################
# Reconstruction Features
########################################################################
#RunParameterOptimization
#RunReconstruction
LazyBFS

# classic optimizer (C++ parity): no LocalOptimizer key
# REFIT voxels are revisited inside the BFS (approximates the C++ multi-client refits).
BFSRevisitRefit 1

########################################################################
FileNumStart				0
FileNumEnd     			3

########################################################################
# Sample Position
########################################################################
SampleLocation      		0 0 0
SampleOrientation   		0 0 0

EnableStrain 0

SampleRadius 0.50
SampleCenter 0.0 0.0 0.0
MaxDiscreteCandidates 30
MaxDeepeningHitRatio 0.8
MinAccelerationThreshold 0.80
OptimizationConstrainFilename ConfigFiles/Constrain.2L
ConsistencyError 5
BraggFilterTolerance 0.1

########################################################################
# Task G3: SmoothCostRank only (decision D-20261029-N3)
########################################################################
# As the integrated configuration (lenient overlap rule, no CandidateDedup, classic MC finisher;
# BatchedQuickMC, SearchDevice and FusedCost off), with OutwardSearch off (key absent, default 0).
BFSReseed 1
# Smooth ranking key of levels 0-2, with the per-image-set SmoothCost cache (D-20261029-N1).
SmoothCostRank E3+E4,tau=0.25

# END OF FILE

