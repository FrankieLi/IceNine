#!/bin/bash
# Git pre-merge-commit hook: the checks of pre-commit, for a merge that git commits by itself.
# git has not recorded the merged branch yet at this point (there is no MERGE_HEAD), so a
# CLAUDE.md/.claude file that the merge brings is refused here. git then leaves the merge staged.
# Conclude it with `git commit`: the pre-commit hook knows the merged branch and passes such a
# file when it is identical to the merged branch's. Activate with scripts/dev/install_hooks.sh.
ROOT=$(git rev-parse --show-toplevel) || exit 1
cd "$ROOT" || exit 1
uv run --project icenine_py python scripts/dev/precommit_check.py && exit 0
echo "pre-merge-commit: refused; the merge is left staged. If the lines above name only" >&2
echo "CLAUDE.md/.claude files that the merged branch brings unchanged, run 'git commit' to" >&2
echo "conclude the merge: that check compares them with the merged branch." >&2
exit 1
