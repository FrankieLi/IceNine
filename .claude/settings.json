{
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(file:*)",
      "Bash(stat:*)",
      "Bash(find:*)",
      "Bash(tree:*)",
      "Bash(diff:*)",
      "Bash(grep -E \"\\\\.py$\")",
      "Bash(time ../../IceNine r ConfigFiles/ReconstructBenchmark.config)"
    ],
    "additionalDirectories": [
      "/tmp"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.command' | grep -qE '(^|&&\\s*|;\\s*|\\|\\s*)(python3?|pytest|pip)\\b' && echo '{\"decision\":\"block\",\"reason\":\"Use uv: \\\"uv run pytest\\\" instead of bare \\\"pytest\\\", \\\"uv run python\\\" instead of \\\"python3\\\", \\\"uv pip\\\" instead of \\\"pip\\\". This project uses uv for Python environment management.\"}' || true",
            "timeout": 5,
            "statusMessage": "Checking for bare Python commands..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/run-tests-on-change.sh",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
